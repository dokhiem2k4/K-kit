#!/usr/bin/env bash
# verify-gate — turns the faithfulness verdict into a BLOCKED action, not a report.
#
# eval-faithfulness.sh measures whether the agent marks `done` without evidence.
# But measuring ends there: a score cannot stop the next time. This hook sits in the middle,
# before the write, and refuses that very action.
#
# Three events, three jobs (registered in hooks/hooks.json):
#   post-bash   a Bash call finished -> output contains "VERIFY OK" -> set the marker for this session
#                                       output contains "VERIFY FAILED" -> clear the marker
#   post-edit   a code file was edited -> clear the marker (code changed, so the last verify proves nothing)
#   pre-edit    about to write status done/verified into feature_list.json -> no marker means REFUSE
#
# The marker lives in temp, keyed by session_id — nothing is written into the user's repo.
#
# FAIL OPEN is deliberate: with no node available the hook lets everything through and warns on stderr.
# A broken gate that blocks every write is worse than no gate at all. That trade-off is written
# down here so nobody mistakes it for fail-closed.

set -uo pipefail
MODE="${1:-}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "harness-kit verify-gate: no node — the gate is NOT active in this session." >&2
  exit 0
fi

MARKER_DIR="${TMPDIR:-/tmp}/harness-kit-verify"
mkdir -p "$MARKER_DIR" 2>/dev/null || exit 0

# stdin (the event JSON) goes straight into node. The script lives in its own file rather than
# a heredoc: a heredoc would take over stdin and node could no longer read the event.
exec node "$SCRIPT_DIR/verify-gate.js" "$MODE" "$MARKER_DIR"
