# harness-kit — example token values (reference only; bootstrap takes them as flags and never reads this file)
#
# node bootstrap.mjs \
#   --target "D:/dev/My-Next-Project" \
#   --name "My Project" \
#   --tagline "One-line description of the project." \
#   --stack "Next.js 15 + Supabase + Chrome MV3" \
#   --blueprint "docs/specs/blueprint.md" \
#   --memory-dir ".claude/memory/"
#
# Tokens replaced in every template file:
#   {{PROJECT_NAME}}   -> --name       (required)
#   {{TAGLINE}}        -> --tagline
#   {{STACK}}          -> --stack
#   {{BLUEPRINT_PATH}} -> --blueprint  (default docs/specs/blueprint.md)
#   {{MEMORY_DIR}}     -> --memory-dir (default .claude/memory/)
#   {{DATE}}           -> today (automatic)
